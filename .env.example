# Pick one provider.

# OpenAI platform: a project key with GPT-Live access.
OPENAI_API_KEY=

# Azure AI Foundry instead: set both, and the OpenAI key is not used. The
# resource needs a gpt-live-1 deployment. BACKEND_MODELS lists the deployment
# names the orchestrator and subagents may use; the first is the default.
# FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
# FOUNDRY_API_KEY=
# BACKEND_MODELS=gpt-5.6-sol,gpt-5-mini

# Boosker mode (optional): the Boosker checkout whose broker code handles the
# call. Default: a Boosker folder beside this one. The claude program must be
# on PATH, or named here.
# BOOSKER_DIR=/path/to/Boosker
# CLAUDE_BIN=/path/to/claude

# PORT=4520
# HOST=127.0.0.1
